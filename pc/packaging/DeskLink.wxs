<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="桌链 DeskLink" Manufacturer="DeskLink" Version="0.1.0" Codepage="65001"
           UpgradeCode="{3f1a2b7c-9d4e-4f6a-8b2c-1e5d7a9c0f31}"
           InstallerVersion="500">
    <WixVariable Id="WixUILicenseRtf" Value="F:\AI Project\VoiceRemoteControl\pc\packaging\LICENSE.rtf" />
    <Icon Id="icon_vrc" SourceFile="F:\AI Project\VoiceRemoteControl\pc\windows-server\assets\vrc.ico" />
    <Property Id="ARPPRODUCTICON" Value="icon_vrc" />
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本，请先卸载旧版。" />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalAppDataProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DeskLink">
          <Component Id="cmp_Root" Guid="{C428A110-8B3A-4A5B-9D7E-F1A2B3C4D5E6}">
            <RegistryValue Root="HKCU" Key="Software\DeskLink\Install" Name="Root" Type="integer" Value="1" KeyPath="yes" />
            <File Id="fil_558F205754904018" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\target\release\vrc-server.exe" />
            <File Id="fil_BE28FA9228EF40EA" Source="F:\AI Project\VoiceRemoteControl\pc\tauri-admin\src-tauri\target\release\vrc-admin.exe" />
            <RemoveFolder Id="rm_Programs" Directory="LocalAppDataProgramsFolder" On="uninstall" />
            <RemoveFolder Id="rm_Install" Directory="INSTALLFOLDER" On="uninstall" />
          </Component>
          <Directory Id="dir_vendor" Name="vendor">
            <Directory Id="dir_vendor_scrcpy" Name="scrcpy">
              <Component Id="cmp_dir_vendor_scrcpy" Guid="{B2345678-90EF-1234-ABCD-FEDCBA987654}">
              <RegistryValue Root="HKCU" Key="Software\DeskLink\Install" Name="VendorScrcpy" Type="integer" Value="1" KeyPath="yes" />
            <File Id="fil_496F40B3EE074E51" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\adb.exe" />
            <File Id="fil_EB22D1781216467D" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\AdbWinApi.dll" />
            <File Id="fil_C2930B4906804A91" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\AdbWinUsbApi.dll" />
            <File Id="fil_A7E7003C717C442B" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\avcodec-63.dll" />
            <File Id="fil_A85DA8C020644E96" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\avformat-63.dll" />
            <File Id="fil_23B605CE80184CC1" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\avutil-61.dll" />
            <File Id="fil_DA99BC197BF045AE" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\disconnected.png" />
            <File Id="fil_A742DC984F2A4EDF" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\libusb-1.0.dll" />
            <File Id="fil_A3ED67DB89C044B6" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\LICENSE.txt" />
            <File Id="fil_97DB39CCC49F4F4B" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\open_a_terminal_here.bat" />
            <File Id="fil_650D57195D8A4270" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\scrcpy.exe" />
            <File Id="fil_B4BF04E8A16944C3" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\scrcpy.png" />
            <File Id="fil_D6BD21E67C8E4530" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\scrcpy-noconsole.vbs" />
            <File Id="fil_99E83B770E444775" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\scrcpy-server" />
            <File Id="fil_1C7532E811C14A61" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\SDL3.dll" />
            <File Id="fil_86027E4E1E0548CB" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\scrcpy\swresample-7.dll" />
              </Component>
            </Directory>
            <Directory Id="dir_vendor_platformtools" Name="platform-tools">
              <Component Id="cmp_dir_vendor_platformtools" Guid="{C3456789-0DEF-1234-5678-9ABCDEF01234}">
              <RegistryValue Root="HKCU" Key="Software\DeskLink\Install" Name="VendorPlatformTools" Type="integer" Value="1" KeyPath="yes" />
            <File Id="fil_2B59D82C89664061" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\platform-tools\adb.exe" />
            <File Id="fil_FFBE39F60D604FE4" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\platform-tools\AdbWinApi.dll" />
            <File Id="fil_EC242032AE1D4878" Source="F:\AI Project\VoiceRemoteControl\pc\windows-server\vendor\platform-tools\AdbWinUsbApi.dll" />
              </Component>
            </Directory>
            <Component Id="cmp_dir_vendor" Guid="{E5678901-2345-6789-BCDE-F0123456789A}">
            <RegistryValue Root="HKCU" Key="Software\DeskLink\Install" Name="Vendor" Type="integer" Value="1" KeyPath="yes" />
              <RemoveFolder Id="rm_Vendor" Directory="dir_vendor" On="uninstall" />
              <RemoveFolder Id="rm_VendorScrcpy" Directory="dir_vendor_scrcpy" On="uninstall" />
              <RemoveFolder Id="rm_VendorPlatformTools" Directory="dir_vendor_platformtools" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDeskLink" Name="桌链 DeskLink">
        <Component Id="cmp_StartMenuShortcut" Guid="{D4567890-1234-5678-ABCD-EF0123456789}">
          <RegistryValue Root="HKCU" Key="Software\DeskLink" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
          <Shortcut Id="scm_DeskLink" Name="桌链 DeskLink" Description="手机与 Windows 协同（语音 / 投屏 / 文件）"
                    Target="[INSTALLFOLDER]vrc-server.exe" WorkingDirectory="INSTALLFOLDER" Icon="icon_vrc" />
          <RemoveFolder Id="rm_StartMenuDeskLink" Directory="ProgramMenuDeskLink" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="cmp_DesktopShortcut" Guid="{F7890123-4567-89AB-CDEF-0123456789BC}">
        <RegistryValue Root="HKCU" Key="Software\DeskLink" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="scm_Desktop" Name="桌链 DeskLink" Description="手机与 Windows 协同（语音 / 投屏 / 文件）"
                  Target="[INSTALLFOLDER]vrc-server.exe" WorkingDirectory="INSTALLFOLDER" Icon="icon_vrc" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main" Title="桌链 DeskLink" Level="1">
      <ComponentRef Id="cmp_Root" />
      <ComponentRef Id="cmp_dir_vendor" />
      <ComponentRef Id="cmp_dir_vendor_scrcpy" />
      <ComponentRef Id="cmp_dir_vendor_platformtools" />
      <ComponentRef Id="cmp_StartMenuShortcut" />
      <ComponentRef Id="cmp_DesktopShortcut" />
    </Feature>
  </Package>
</Wix>